    "Camera is unavailable on this device. Choose a photo from your library instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera is unavailable on this device. Choose a photo from your library instead."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không có camera khả dụng. Hãy chọn ảnh từ thư viện."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكاميرا غير متاحة على هذا الجهاز. اختر صورة من مكتبتك بدلاً من ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে ক্যামেরা উপলব্ধ নেই। পরিবর্তে আপনার লাইব্রেরি থেকে একটি ছবি বেছে নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist auf diesem Gerät nicht verfügbar. Wähle stattdessen ein Foto aus deiner Mediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible en este dispositivo. Elige una foto de tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra est indisponible sur cet appareil. Choisissez une photo dans votre photothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצלמה אינה זמינה במכשיר זה. ניתן לבחור תמונה מהספרייה במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर कैमरा उपलब्ध नहीं है। इसके बजाय अपनी लाइब्रेरी से फ़ोटो चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera tidak tersedia di perangkat ini. Pilih foto dari perpustakaan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile su questo dispositivo. Scegli una foto dalla libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカメラを利用できません。ライブラリから写真を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 카메라를 사용할 수 없습니다. 대신 보관함에서 사진을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera is niet beschikbaar op dit apparaat. Kies een foto uit je bibliotheek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está disponível neste dispositivo. Escolha uma foto da sua fototeca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна на этом устройстве. Выберите фото из медиатеки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ไม่มีกล้องที่ใช้งานได้ โปรดเลือกรูปจากคลังรูปภาพแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aygıtta kamera kullanılamıyor. Bunun yerine arşivinizden bir fotoğraf seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна на цьому пристрої. Натомість виберіть фото з фототеки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法使用相机。请从图库中选择照片。"
          }
        }
      }
    },
    "Allow camera access in Settings to take a photo. You can also choose a photo from your library.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow camera access in Settings to take a photo. You can also choose a photo from your library."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập camera trong Cài đặt để chụp ảnh. Bạn cũng có thể chọn ảnh từ thư viện."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الكاميرا في الإعدادات لالتقاط صورة. يمكنك أيضًا اختيار صورة من مكتبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবি তুলতে সেটিংসে ক্যামেরার অনুমতি দিন। আপনি আপনার লাইব্রেরি থেকেও ছবি বেছে নিতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Kamerazugriff in den Einstellungen, um ein Foto aufzunehmen. Du kannst auch ein Foto aus deiner Mediathek wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la cámara en Ajustes para hacer una foto. También puedes elegir una foto de tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à la caméra dans Réglages pour prendre une photo. Vous pouvez aussi choisir une photo dans votre photothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאפשר גישה למצלמה בהגדרות כדי לצלם תמונה. ניתן גם לבחור תמונה מהספרייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो लेने के लिए सेटिंग्स में कैमरे की अनुमति दें। आप अपनी लाइब्रेरी से भी फ़ोटो चुन सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses kamera di Pengaturan untuk mengambil foto. Anda juga dapat memilih foto dari perpustakaan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso alla fotocamera in Impostazioni per scattare una foto. Puoi anche scegliere una foto dalla libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮るには、設定でカメラへのアクセスを許可してください。ライブラリから写真を選択することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 촬영하려면 설정에서 카메라 접근을 허용하세요. 보관함에서 사진을 선택할 수도 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta cameratoegang toe in Instellingen om een foto te maken. Je kunt ook een foto uit je bibliotheek kiezen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso à câmera nos Ajustes para tirar uma foto. Você também pode escolher uma foto da sua fototeca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к камере в настройках, чтобы сделать фото. Вы также можете выбрать фото из медиатеки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้เข้าถึงกล้องในการตั้งค่าเพื่อถ่ายรูป คุณยังสามารถเลือกรูปจากคลังรูปภาพได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf çekmek için Ayarlar’da kamera erişimine izin verin. Arşivinizden de bir fotoğraf seçebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте доступ до камери в Параметрах, щоб зробити фото. Ви також можете вибрати фото з фототеки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中允许访问相机以拍照。您也可以从图库中选择照片。"
          }
        }
      }
    }
  },
  "version" : "1.1"
}
