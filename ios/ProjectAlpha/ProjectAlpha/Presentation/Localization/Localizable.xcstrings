            "state": "translated",
            "value": "Delete \"%@\"? This cannot be undone."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa “%@”? Không thể hoàn tác thao tác này."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف «%@»؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ löschen? Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar «%@»? Esta acción no se puede deshacer."
          }
        },
