          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze collectie is elders gewijzigd. Laad de nieuwste versie of pas je bewerkingen opnieuw toe.\n\nJouw bewerkingen: %1$@\nLaatst opgeslagen: %2$@"
