        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอลเลกชันนี้ถูกเปลี่ยนจากที่อื่น โหลดเวอร์ชันล่าสุดหรือใช้การแก้ไขของคุณอีกครั้ง\n\nการแก้ไขของคุณ: %1$@\nชื่อล่าสุดที่บันทึกไว้: %2$@"
