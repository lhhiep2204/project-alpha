          "stringUnit": {
            "state": "translated",
            "value": "Supprimer « %@ » ? Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” मिटाएँ? इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus “%@”? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare “%@”? Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”을(를) 삭제할까요? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%@»? Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ “%@” หรือไม่ การดำเนินการนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” silinsin mi? Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除“%@”？此操作无法撤销。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” মুছবেন? এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק את ״%@״? לא ניתן לבטל פעולה זו."
