          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это место изменено в другом окне. Проверьте его перед удалением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานที่นี้ถูกเปลี่ยนแปลงจากที่อื่น โปรดตรวจสอบก่อนลบ"
