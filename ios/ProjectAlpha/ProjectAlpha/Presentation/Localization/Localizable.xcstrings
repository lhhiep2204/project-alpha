    "This location changed elsewhere. Reload the latest version or reapply your edits." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This location changed elsewhere. Reload the latest version or reapply your edits."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa điểm này đã được thay đổi ở nơi khác. Tải lại phiên bản mới nhất hoặc áp dụng lại chỉnh sửa của bạn."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير هذا المكان في مكان آخر. أعد تحميل أحدث نسخة أو أعد تطبيق تعديلاتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই স্থানটি অন্য কোথাও পরিবর্তিত হয়েছে। সর্বশেষ সংস্করণ আবার লোড করুন অথবা আপনার সম্পাদনা আবার প্রয়োগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ort wurde anderswo geändert. Lade die neueste Version oder wende deine Änderungen erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este lugar ha cambiado en otro sitio. Vuelve a cargar la última versión o aplica de nuevo tus cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lieu a été modifié ailleurs. Rechargez la dernière version ou réappliquez vos modifications."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המקום הזה השתנה במקום אחר. יש לטעון מחדש את הגרסה האחרונה או להחיל שוב את העריכות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्थान कहीं और बदल गया है। नवीनतम संस्करण फिर लोड करें या अपने बदलाव फिर लागू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi ini diubah di tempat lain. Muat ulang versi terbaru atau terapkan kembali perubahan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo luogo è stato modificato altrove. Ricarica la versione più recente o riapplica le tue modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この場所は別の場所で変更されました。最新バージョンを再読み込みするか、編集内容を再適用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 장소가 다른 곳에서 변경되었습니다. 최신 버전을 다시 불러오거나 편집 내용을 다시 적용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze locatie is elders gewijzigd. Laad de nieuwste versie opnieuw of pas je wijzigingen opnieuw toe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este local foi alterado noutro lugar. Recarregue a versão mais recente ou reaplique as suas alterações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это место изменено в другом окне. Загрузите последнюю версию или примените свои изменения повторно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це місце змінено в іншому вікні. Завантажте останню версію або застосуйте свої зміни повторно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สถานที่นี้ถูกเปลี่ยนแปลงจากที่อื่น โหลดเวอร์ชันล่าสุดใหม่หรือนำการแก้ไขของคุณไปใช้อีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu konum başka bir yerde değiştirildi. Son sürümü yeniden yükleyin veya düzenlemelerinizi yeniden uygulayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地点已在其他地方更改。请重新载入最新版本或重新应用你的编辑。"
          }
        }
      }
    },
