    "This collection changed before deletion. Review the latest details and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت هذه المجموعة قبل حذفها. راجع أحدث التفاصيل ثم حاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মুছে ফেলার আগে সংগ্রহটি পরিবর্তিত হয়েছে। সর্বশেষ বিবরণ দেখে আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sammlung wurde vor dem Löschen geändert. Prüfe die aktuellen Details und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This collection changed before deletion. Review the latest details and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta colección cambió antes de eliminarla. Revisa los datos actuales e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette collection a changé avant sa suppression. Vérifiez les détails actuels et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האוסף השתנה לפני המחיקה. יש לבדוק את הפרטים העדכניים ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह संग्रह हटाने से पहले बदल गया। नवीनतम विवरण देखें और फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koleksi ini berubah sebelum dihapus. Tinjau detail terbaru lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La raccolta è cambiata prima dell’eliminazione. Controlla i dettagli aggiornati e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除前にコレクションが変更されました。最新の内容を確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제하기 전에 컬렉션이 변경되었습니다. 최신 내용을 확인하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze collectie is gewijzigd vóór het verwijderen. Bekijk de nieuwste details en probeer het opnieuw."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta coleção mudou antes de ser excluída. Confira os detalhes atuais e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коллекция изменилась перед удалением. Проверьте актуальные сведения и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอลเลกชันเปลี่ยนไปก่อนลบ ตรวจสอบรายละเอียดล่าสุดแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koleksiyon silinmeden önce değişti. Güncel ayrıntıları inceleyip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колекцію змінено перед видаленням. Перегляньте актуальні дані й повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ sưu tập đã thay đổi trước khi xóa. Xem chi tiết mới nhất rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除前此收藏集已更改。请查看最新详情后重试。"
          }
        }
      }
    },
    "This collection changed elsewhere. Reload the latest version or reapply your edits.\n\nYour edits: %1$@\nLatest saved: %2$@" : {
      "comment" : "Stale collection editor comparison. %1$@ is the unmodified local draft name; %2$@ is the latest committed name. Keep both names and the reload/reapply instructions.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت هذه المجموعة في مكان آخر. حمّل أحدث نسخة أو أعد تطبيق تعديلاتك.\n\nتعديلاتك: %1$@\nأحدث اسم محفوظ: %2$@"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সংগ্রহটি অন্য জায়গায় পরিবর্তিত হয়েছে। সর্বশেষ সংস্করণ লোড করুন বা আপনার সম্পাদনা আবার প্রয়োগ করুন।\n\nআপনার সম্পাদনা: %1$@\nসর্বশেষ সংরক্ষিত নাম: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sammlung wurde an anderer Stelle geändert. Lade die neueste Version oder wende deine Änderungen erneut an.\n\nDeine Änderungen: %1$@\nZuletzt gespeichert: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This collection changed elsewhere. Reload the latest version or reapply your edits.\n\nYour edits: %1$@\nLatest saved: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta colección cambió en otro lugar. Carga la versión más reciente o vuelve a aplicar tus cambios.\n\nTus cambios: %1$@\nÚltimo nombre guardado: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette collection a été modifiée ailleurs. Rechargez la dernière version ou réappliquez vos modifications.\n\nVos modifications: %1$@\nDernier nom enregistré: %2$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האוסף השתנה במקום אחר. יש לטעון את הגרסה העדכנית או להחיל שוב את העריכות.\n\nהעריכות שלך: %1$@\nהשם האחרון שנשמר: %2$@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
